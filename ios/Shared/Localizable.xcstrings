    "Lowest voltage under load this ride: %@ V at %lld W": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Lowest voltage under load this ride: %1$@ V at %2$lld W"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laagste spanning onder belasting deze rit: %@ V bij %lld W"
          }
        }
      }
    },
    "Made for bikes with a faulty battery. Tested on a Cowboy 3 only.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemaakt voor fietsen met een defecte accu. Alleen getest op een Cowboy 3."
          }
        }
      }
    },
    "Make sure the bike is awake and nearby. Your iPhone already knows the bike from the official app, so no code should be needed.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg dat de fiets wakker is en in de buurt staat. Je iPhone kent de fiets al van de officiële app, dus een code zou niet nodig moeten zijn."
          }
        }
      }
    },
