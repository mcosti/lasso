    "Start free trial": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start gratis proefperiode"
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        }
